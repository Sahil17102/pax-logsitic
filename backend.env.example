# Set these only on the Render backend web service.
NODE_ENV=production
REQUIRE_DATABASE=true
FRONTEND_URLS=https://paxlogistic.onrender.com,https://pax-logsiticadmin-utus.onrender.com
DATABASE_URL=<set-this-secret-in-render-dashboard>
