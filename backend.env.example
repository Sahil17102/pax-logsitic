# Set these only on the Render backend web service.
NODE_ENV=production
REQUIRE_DATABASE=false
OTP_DELIVERY_MODE=onscreen
FRONTEND_URLS=https://paxlogistic.onrender.com,https://pax-logsiticadmin-utus.onrender.com
DATABASE_URL=<set-this-secret-in-render-dashboard>
DATABASE_SSL=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-a-strong-admin-password>
ADMIN_PASSWORD_SHA256=<optional-sha256-fallback-when-admin-password-is-unset>
JWT_SECRET=<generate-a-long-random-secret>
SEED_ADMIN_ID=ADM-SUPER-001
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Pax Super Admin
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<set-a-strong-seed-password>
DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=<set-the-delhivery-b2c-token>
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_REQUEST_TIMEOUT_MS=5000
DELHIVERY_RATE_LIMIT_REQUESTS=4000
DELHIVERY_HEAVY_RATE_LIMIT_REQUESTS=2700
